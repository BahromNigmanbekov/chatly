rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- calls (collection-group access for the global incoming-call
    // listener) --------------------------------------------------------------
    // Collection-group queries (collectionGroup(db, 'calls')) are validated
    // against a recursive-wildcard rule, not the nested exact-path one under
    // /chats/{chatId} — that nested rule alone governs single-document get()s
    // and per-chat queries, but the app-wide list query needs this one too.
    match /{path=**}/calls/{callId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('participantIds', []);
    }

    // ---- users -----------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      // Changing `username` here must be paired with the matching claim in
      // `usernames/{username}` (written in the same client transaction) —
      // getAfter() checks the post-commit state of that other document.
      allow update: if isSelf(uid) && (
        !('username' in affectedKeys()) ||
        getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == uid
      );
      allow delete: if false;
    }

    // ---- usernames (uniqueness claims) ------------------------------------
    match /usernames/{username} {
      function validFormat() {
        return username.matches('^[a-z0-9_]{5,32}$');
      }

      // Public so the "band/bo'sh" availability check works before sign-up
      // (an account doesn't exist yet at that point). The doc only holds a uid,
      // same exposure level as "this @handle is taken" on any other platform.
      allow read: if true;
      // Only fires when the doc doesn't exist yet — i.e. the username is free.
      allow create: if isSignedIn()
        && validFormat()
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid;
      // Only fires when the doc already exists — only its current owner may touch it.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- chats -------------------------------------------------------------
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }
      function isAdmin() {
        return isSignedIn() && request.auth.uid in resource.data.adminIds;
      }
      function isOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }
      function onlyMessagingFieldsChanged() {
        return affectedKeys().hasOnly(['lastMessage', 'typingStatus', 'unreadCounts']);
      }
      function onlyPinChanged() {
        return affectedKeys().hasOnly(['pinnedMessageId']);
      }
      function onlyPinnedByChanged() {
        return affectedKeys().hasOnly(['pinnedBy']);
      }
      // Personal "pin this chat to my list" toggle — only my own uid may be
      // added/removed, and only one entry at a time (blocks tampering with
      // other participants' pinned state in the same write).
      function isSelfPinToggle() {
        return (request.auth.uid in request.resource.data.pinnedBy) != (request.auth.uid in resource.data.pinnedBy)
          && request.resource.data.pinnedBy.size() == resource.data.pinnedBy.size()
            + ((request.auth.uid in request.resource.data.pinnedBy) ? 1 : -1);
      }
      function onlyGroupSettingsChanged() {
        return affectedKeys().hasOnly(['groupName', 'groupPhotoURL', 'onlyAdminsCanPost']);
      }
      function onlyMembershipChanged() {
        return affectedKeys().hasOnly(['participantIds', 'adminIds', 'unreadCounts']);
      }
      function isSelfLeaving() {
        return affectedKeys().hasOnly(['participantIds', 'adminIds', 'unreadCounts'])
          && !(request.auth.uid in request.resource.data.participantIds)
          && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isParticipant();

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && (
          (request.resource.data.type == 'direct' && request.resource.data.participantIds.size() == 2)
          || (
            request.resource.data.type == 'group'
            && request.resource.data.ownerId == request.auth.uid
            && request.auth.uid in request.resource.data.adminIds
          )
        );

      allow update: if isParticipant() && (
        onlyMessagingFieldsChanged()
        || (onlyGroupSettingsChanged() && isAdmin())
        || (onlyMembershipChanged() && isAdmin())
        || isSelfLeaving()
        // Pinning a message: any participant in a direct chat, admins only in a group.
        || (onlyPinChanged() && (resource.data.type == 'direct' || isAdmin()))
        // Pinning the *chat itself* to my own list: any participant, self only.
        || (onlyPinnedByChanged() && isSelfPinToggle())
      );

      allow delete: if isOwner();

      // ---- messages ----------------------------------------------------
      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isChatParticipant() {
          return isSignedIn() && request.auth.uid in chatData().participantIds;
        }
        function isChatAdmin() {
          return isSignedIn() && request.auth.uid in chatData().adminIds;
        }
        function msgAffectedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        allow read: if isChatParticipant();

        allow create: if isChatParticipant()
          && request.resource.data.senderId == request.auth.uid
          && (!chatData().onlyAdminsCanPost || isChatAdmin());

        // Status/read receipts (any participant), hiding-for-self (any participant),
        // the original sender editing their own text message (content + edit
        // markers), or the original sender performing an "everyone" delete
        // (content -> system).
        allow update: if isChatParticipant() && (
          msgAffectedKeys().hasOnly(['status', 'readBy'])
          || msgAffectedKeys().hasOnly(['deletedFor'])
          // Reactions: any participant, toggling their own emoji pill.
          || msgAffectedKeys().hasOnly(['reactions'])
          || (
            msgAffectedKeys().hasOnly(['content', 'isEdited', 'editedAt'])
            && resource.data.senderId == request.auth.uid
            && resource.data.type == 'text'
          )
          || (
            msgAffectedKeys().hasOnly(['type', 'content', 'mediaURL'])
            && resource.data.senderId == request.auth.uid
          )
          // Voice-message auto-expiry sweep (20 min after createdAt): any
          // participant's client can trigger it, not just the sender — it's
          // best-effort housekeeping run whenever a chat is opened/updated.
          || (
            msgAffectedKeys().hasOnly(['mediaURL', 'voiceExpired'])
            && resource.data.type == 'voice'
          )
        );

        allow delete: if false;
      }

      // ---- calls (LiveKit-backed signaling: 1-on-1 + group) -------------
      match /calls/{callId} {
        // Same array-contains pattern already used for /chats — Firestore can
        // statically prove a `list` query safe when the rule checks
        // array-membership on the exact field an `array-contains` filter
        // constrains, which a plain field-equality OR can't be proven by.
        // .get(field, default) guards against the rule validator's synthetic
        // empty-document probe throwing on a direct field access.
        function isCallParticipant() {
          return isSignedIn() && request.auth.uid in resource.data.get('participantIds', []);
        }

        allow read: if isCallParticipant();

        // 1:1 calls invite exactly 2 people and start "ringing"; group calls
        // invite the whole chat's membership and start "active" directly (no
        // ring/accept step — see types/call.ts). No SDP/ICE data lives on this
        // doc, just the LiveKit room name (roomName) — the actual media
        // connection happens directly against LiveKit Cloud, outside Firestore.
        allow create: if isSignedIn()
          && request.resource.data.callerId == request.auth.uid
          && request.auth.uid in request.resource.data.participantIds
          && (
            (request.resource.data.isGroup == false && request.resource.data.participantIds.size() == 2)
            || (request.resource.data.isGroup == true && request.resource.data.participantIds.size() >= 1)
          );

        // Any invited participant can flip status (accept/decline/end) —
        // field-level diffing isn't worth the complexity for a call doc only
        // its own participants can ever read or reach in the first place.
        allow update: if isCallParticipant();

        allow delete: if isCallParticipant();
      }
    }
  }
}
