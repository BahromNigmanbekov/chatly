rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isChatMedia() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType.matches('audio/.*');
    }

    function chatParticipantIds(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participantIds;
    }

    function chatAdminIds(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId)).data.adminIds;
    }

    // Profile photos — only the owner can upload to their own folder.
    match /avatars/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isImage()
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Group photos. `pending-{uid}` is a temporary folder used while a group is
    // being created client-side, before the chat document (and its adminIds) exists.
    match /groups/{folder}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && isImage()
        && request.resource.size < 10 * 1024 * 1024
        && (
          folder == 'pending-' + request.auth.uid
          || request.auth.uid in chatAdminIds(folder)
        );
    }

    // Chat media (images, videos, voice notes) — only chat participants.
    match /chats/{chatId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid in chatParticipantIds(chatId);
      allow write: if isSignedIn()
        && request.auth.uid in chatParticipantIds(chatId)
        && isChatMedia()
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
